 "beats": {
  "U001": {
   "kw": "Night sky",
   "sub": "Look up at the night sky.",
   "log": "Look up: infinite wonder",
   "badge": "The night sky"
  },
  "U002": {
   "sub": "Wonder takes over."
  },
  "U003": {
   "sub": "For thousands of years we watched the stars.",
   "log": "Millennia of stargazing",
   "badge": "The stars"
  },
  "U004": {
   "sub": "Our destiny, we believed: explore every corner."
  },
  "U005": {
   "kw": "Telescopes",
   "sub": "We built telescopes and launched rockets.",
   "log": "Telescopes, then rockets",
   "badge": "The void"
  },
  "U006": {
   "kw": "The edge",
   "sub": "Dreaming of the ultimate edge of existence.",
   "log": "Dream: the ultimate edge",
   "badge": "The edge"
  },
  "U007": {
   "kw": "But",
   "acc": true,
   "sub": "Astrophysics found a truth that shatters it."
  },
  "U008": {
   "kw": "A barrier",
   "sub": "An invisible wall in the laws of reality.",
   "log": "A cosmic barrier"
  },
  "U009": {
   "sub": "We will never escape our cosmic backyard.",
   "log": "We never escape"
  },
  "U010": {
   "sub": "To understand our imprisonment..."
  },
  "U011": {
   "sub": "...look at our greatest act of exploration."
  },
  "U012": {
   "kw": "Voyager 1",
   "sub": "Voyager 1, launched in 1977.",
   "log": "Voyager 1, launched 1977",
   "badge": "Launched 1977"
  },
  "U013": {
   "kw": "38,000 mph",
   "sub": "Over 38,000 mph for nearly half a century.",
   "log": "38,000 mph, ~50 years"
  },
  "U014": {
   "sub": "Farther than anything humans ever built.",
   "log": "Farthest human-made object"
  },
  "U015": {
   "kw": "Front porch",
   "acc": true,
   "sub": "Cosmically, it barely left the front porch."
  },
  "U016": {
   "sub": "Still inside the Sun's outer gravitational grip.",
   "log": "Still in the Sun's grip",
   "badge": "Sun's grip"
  },
  "U017": {
   "sub": "Wandering an endless desert of nothing."
  },
  "U018": {
   "kw": "73,000 years",
   "sub": "Over 73,000 years at its current speed...",
   "log": "To Proxima: 73,000+ years",
   "badge": "73,000 years"
  },
  "U019": {
   "kw": "Proxima",
   "sub": "...to reach Proxima Centauri, our nearest star."
  },
  "U020": {
   "sub": "Think about that timeframe."
  },
  "U021": {
   "sub": "Empires rose and fell..."
  },
  "U022": {
   "sub": "...in a small fraction of that time.",
   "log": "Empires rise and fall faster"
  },
  "U023": {
   "sub": "Proxima is merely our next-door neighbor."
  },
  "U024": {
   "kw": "4.2 light-years",
   "sub": "About 4.2 light-years away.",
   "log": "Proxima: 4.2 light-years",
   "badge": "4.2 ly"
  },
  "U025": {
   "kw": "100,000 ly",
   "sub": "In a galaxy over 100,000 light-years across.",
   "log": "Galaxy: 100,000+ ly",
   "badge": "100,000 ly"
  },
  "U026": {
   "sub": "Longer than all of recorded history..."
  },
  "U027": {
   "kw": "The edge?",
   "acc": true,
   "sub": "How could we ever reach the edge?"
  },
  "U028": {
   "sub": "Maybe our engines are just too primitive.",
   "plot": 0.05
  },
  "U029": {
   "kw": "Light speed?",
   "sub": "Future engines might approach light speed.",
   "plot": 0.1
  },
  "U030": {
   "sub": "But physics has a first brutal law.",
   "plot": 0.12
  },
  "U031": {
   "kw": "Einstein",
   "sub": "Einstein: light speed is not just a speed.",
   "log": "Einstein's law",
   "plot": 0.15
  },
  "U032": {
   "kw": "Speed limit",
   "acc": true,
   "sub": "It is the speed limit of cause and effect.",
   "log": "The cosmic speed limit",
   "badge": "Limit",
   "plot": 0.18
  },
  "U033": {
   "kw": "186,000 mi/s",
   "sub": "About 186,000 miles per second.",
   "log": "Light: 186,000 mi/s",
   "badge": "186,000 mi/s",
   "plot": 0.2
  },
  "U034": {
   "sub": "Nothing carries information faster.",
   "plot": 0.22
  },
  "U035": {
   "sub": "Nothing with mass can reach it.",
   "log": "Mass can never reach it",
   "plot": 0.25
  },
  "U036": {
   "kw": "Faster",
   "sub": "Push a mass closer to light speed...",
   "plot": 0.35
  },
  "U037": {
   "kw": "More energy",
   "sub": "Each bit of speed costs more energy.",
   "log": "Each step costs more",
   "plot": 0.5
  },
  "U038": {
   "kw": "Infinity",
   "sub": "The total climbs toward infinity.",
   "log": "Energy climbs to infinity",
   "badge": "Toward infinity",
   "plot": 0.75
  },
  "U039": {
   "sub": "Light speed itself: infinite energy.",
   "plot": 0.88
  },
  "U040": {
   "sub": "Not enough in all the stars and galaxies...",
   "plot": 0.92
  },
  "U041": {
   "sub": "...and black holes combined...",
   "plot": 0.95
  },
  "U042": {
   "kw": "Door shut",
   "acc": true,
   "sub": "...to push one ship to light speed.",
   "plot": 0.98
  },
  "U043": {
   "sub": "Locked behind the bars of sub-light speed.",
   "log": "Locked below light speed",
   "badge": "Sub-light",
   "plot": 1
  },
  "U044": {
   "sub": "Even if we could bend reality..."
  },
  "U045": {
   "kw": "99.9%",
   "sub": "...and travel at 99.9% of light speed...",
   "log": "Even at 99.9% of c",
   "badge": "99.9% of c"
  },
  "U046": {
   "kw": "Scale",
   "acc": true,
   "sub": "...the scale of the cosmos mocks us."
  },
  "U048": {
   "kw": "Zoom out",
   "sub": "Zoom out to this level..."
  },
  "U049": {
   "kw": "A speck",
   "sub": "We are a speck of dust in an ocean of silence.",
   "log": "Less than a speck of dust",
   "badge": "A speck"
  },
  "U050": {
   "sub": "We took comfort in one idea..."
  },
  "U051": {
   "kw": "Static",
   "sub": "The universe, at least, was static.",
   "log": "Comfort: a static universe",
   "badge": "Static"
  },
  "U052": {
   "sub": "In a still universe, with infinite time..."
  },
  "U053": {
   "sub": "...you could cross any distance.",
   "log": "Any distance, given time"
  },
  "U054": {
   "kw": "1929",
   "sub": "That picture began to fall apart in 1929."
  },
  "U055": {
   "kw": "Edwin Hubble",
   "sub": "Thanks to astronomer Edwin Hubble.",
   "log": "1929: Edwin Hubble"
  },
  "U056": {
   "kw": "100-inch",
   "sub": "The 100-inch Hooker telescope, Mount Wilson.",
   "log": "100-inch Hooker telescope"
  },
  "U057": {
   "sub": "A pattern that shook science."
  },
  "U058": {
   "kw": "Expanding",
   "acc": true,
   "sub": "The universe is expanding.",
   "log": "It is expanding",
   "badge": "Expanding"
  },
  "U059": {
   "sub": "Hubble studied light from distant galaxies."
  },
  "U060": {
   "kw": "Redshift",
   "sub": "Their light was shifted toward red.",
   "log": "Galaxy light shifted red",
   "badge": "Redshift"
  },
  "U061": {
   "sub": "At first it looked like the Doppler effect..."
  },
  "U062": {
   "kw": "Doppler?",
   "sub": "...like a siren racing away."
  },
  "U063": {
   "kw": "Farther, faster",
   "sub": "Farther galaxies seemed faster.",
   "log": "Farther = faster"
  },
  "U064": {
   "sub": "Not random drifting through space."
  },
  "U065": {
   "sub": "Galaxies receding from each other everywhere...",
   "log": "Everything recedes"
  },
  "U066": {
   "kw": "Balloon",
   "sub": "...like dots on an inflating balloon."
  },
  "U067": {
   "kw": "Intuition fails",
   "sub": "Here intuition fails."
  },
  "U068": {
   "sub": "Galaxies are not flying like bullets."
  },
  "U069": {
   "kw": "Space stretches",
   "acc": true,
   "sub": "Space itself is stretching between them.",
   "log": "Space itself stretches",
   "badge": "Stretching"
  },
  "U070": {
   "kw": "Fabric",
   "sub": "Space is not a stage, but a living fabric."
  },
  "U071": {
   "sub": "New cubic light-years keep appearing...",
   "log": "New space keeps appearing"
  },
  "U072": {
   "sub": "...pushing everything apart, every moment."
  },
  "U073": {
   "kw": "Hubble's Law",

 "beats": {
  "U001": {
   "kw": "Tiny speck",
   "sub": "Every human who ever lived is in this point of light."
  },
  "U002": {
   "kw": "Every king",
   "sub": "Every war, every love story."
  },
  "U003": {
   "kw": "One pixel",
   "sub": "All on a point smaller than a single pixel."
  },
  "U004": {
   "kw": "Pale Blue Dot",
   "acc": true,
   "sub": "Maybe the most humbling photograph ever taken."
  },
  "U005": {
   "kw": "1977",
   "sub": "NASA launches Voyager 1."
  },
  "U006": {
   "kw": "Jupiter, Saturn",
   "sub": "Past Jupiter in 1979, past Saturn in 1980."
  },
  "U007": {
   "sub": "Out toward the edge of the solar system."
  },
  "U008": {
   "kw": "38,000 mph",
   "sub": "About 38,000 miles per hour."
  },
  "U009": {
   "kw": "Carl Sagan",
   "sub": "On the Voyager imaging team, he had an idea."
  },
  "U010": {
   "sub": "Before the probe left for good..."
  },
  "U011": {
   "kw": "Look back",
   "acc": true,
   "sub": "Turn the camera around for one last look at home."
  },
  "U012": {
   "kw": "Risky",
   "sub": "The camera would point close to the Sun."
  },
  "U013": {
   "kw": "Feb 14, 1990",
   "sub": "The team sent the command."
  },
  "U014": {
   "kw": "60 frames",
   "sub": "Taken from 3.7 billion miles away."
  },
  "U015": {
   "sub": "A family portrait of the solar system."
  },
  "U016": {
   "kw": "Earth",
   "sub": "Caught inside a ray of scattered sunlight."
  },
  "U017": {
   "kw": "0.12 pixel",
   "acc": true,
   "sub": "A pale blue dot."
  },
  "U018": {
   "kw": "Cameras off",
   "sub": "Thirty-four minutes later, switched off forever."
  },
  "U019": {
   "sub": "Power saved for the long journey. The last pictures."
  },
  "U020": {
   "kw": "So faint",
   "sub": "The signal was faint, and very far away."
  },
  "U021": {
   "kw": "May 1990",
   "sub": "Only then had all the image data reached Earth."
  },
  "U022": {
   "kw": "1994",
   "sub": "Sagan's book took its name: Pale Blue Dot."
  },
  "U023": {
   "kw": "That is us",
   "acc": true,
   "sub": "Look again at that dot. That is home."
  },
  "U024": {
   "sub": "Everyone we love, everyone we have ever heard of."
  },
  "U025": {
   "kw": "Mote of dust",
   "sub": "Suspended in a sunbeam."
  },
  "U026": {
   "kw": "Interstellar",
   "sub": "Voyager 1 is still out there."
  },
  "U027": {
   "kw": "Nov 18, 2026",
   "sub": "The first human-made object to get this far."
  },
  "U028": {
   "kw": "One light-day",
   "acc": true,
   "sub": "One light-day from Earth."
  },
  "U029": {
   "kw": "A full day",
   "sub": "A radio message from us takes a full day to arrive."
  },
  "U030": {
   "kw": "No borders",
   "sub": "No borders and no nations, seen from out there."
  },
  "U031": {
   "kw": "Fragile",
   "sub": "The only home we have ever known."
  },
  "U032": {
   "kw": "Take care",
   "acc": true,
   "sub": "Look at it closely, and take care of it."
  },
  "U033": {
   "sub": "The full story of our cosmic prison: Miya's Lab."
  }
 }
}
    "#36d6d0",
    "#8a6bff",
    "#ffd27a"
   ]
  },
  "text": "According to classical physics, matter carries information about its properties into a black hole.",
  "dur": 7.2,
  "transition_in": "fade",
  "prev": "",
  "nxt": "A falling star, a drifting cloud of gas, or a dropped book each carries a complete description of itself.",
  "frog_hint": false
 },

    "#36d6d0",
    "#8a6bff",
    "#ffd27a"
   ]
  },
  "text": "Start with information. In physics, information is the description of what something is: its properties, its arrangement, its state.",
  "dur": 9.12,
  "transition_in": "zoom",
  "prev": "",
  "nxt": "",
  "frog_hint": true
 },
 {
